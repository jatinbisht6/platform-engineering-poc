PHASE 1.5: Install Prometheus
└─ Command: helm upgrade --install prometheus prometheus-community/prometheus \
             -f platform/observability/prometheus/values.yaml \
             --namespace platform-system
└─ Expected: Prometheus server pod running
└─ Access: http://localhost:9090

PHASE 1.6: Install Grafana
└─ Command: helm upgrade --install grafana grafana/grafana \
             -f platform/observability/grafana/values.yaml \
             --namespace platform-system
└─ Expected: Grafana pod running
└─ Access: http://localhost:3000 (default: admin/admin)

PHASE 1.7: Install cert-manager
└─ Command: helm upgrade --install cert-manager jetstack/cert-manager \
             --namespace platform-system \
             --version v1.14.5 \
             --set installCRDs=true \
             --set global.leaderElection.namespace=platform-system
└─ Expected: 3 cert-manager pods (cert-manager, webhook, cainjector)

PHASE 1.8: Install Kafka Strimzi Operator
